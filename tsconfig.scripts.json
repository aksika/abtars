{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "rootDir": ".",
        "allowImportingTsExtensions": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "scripts/check-imports-fixture/**"
    ]
}
